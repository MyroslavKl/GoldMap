  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p tests",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-data.ts",
    "test:data": "node --test scripts/data.test.ts",
    "test:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test tests/db.test.ts",
    "test": "npm run test:data && npm run test:db && npm run test:lib && npm run test:globe",
    "db:generate": "drizzle-kit generate",
    "build:globe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning scripts/build-globe.ts",
    "postinstall": "npm run build:globe",
    "test:globe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test tests/globe.test.ts",
    "test:lib": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --test tests/lib.test.ts"
  },
  "private": true
